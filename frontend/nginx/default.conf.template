# The official nginx image runs envsubst over this file when the container starts,
# replacing ${VITE_API_BASE_URL} below. nginx's own $variables are left untouched.
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Runtime settings for the app. Generated here, not baked into the build, so the
    # backend URL can be changed with an environment variable and no rebuild.
    location = /config.js {
        default_type application/javascript;
        add_header Cache-Control "no-store";
        return 200 'window.__APP_CONFIG__ = { apiBaseUrl: "${VITE_API_BASE_URL}" };';
    }

    # Vite puts a content hash in these file names, so they can be cached for good.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Single-page app: every other path is handled by the React router.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
