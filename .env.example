# Optional overrides for docker compose. Copy to .env and edit; every value has a default.

# How long an application holds a seat before it is released (seconds).
HOLD_DURATION_SECONDS=600

# Backend URL that the browser uses. Change it if the backend is published elsewhere.
VITE_API_BASE_URL=http://localhost:8080

# Host port for the frontend.
FRONTEND_PORT=5173

# Browser origins allowed to call the API (comma-separated, or * for any).
CORS_ALLOWED_ORIGINS=*
